#!/bin/bash
while true;
    do
    echo "Основное меню"
    echo "Возможность ввода: help, request, exit"
    read message
    if [[ "$message" == "help" ]];
    then
    echo "############################################################################################################################################################################################"
    echo "Справка:"
    echo "
    777 Полные права (rwx)	Полные права (rwx)	rwxrwxrwx	Абсолютный доступ для всех. Любой пользователь системы может читать, изменять и удалять этот объект. Крайне небезопасно для боевых серверов.
    "
    echo "
    766	Чтение и запись (rw-)	Чтение и запись (rw-)	rwxr--w--w	Все могут править, но не запускать. Группа и мир могут редактировать файлы, но запустить скрипт или открыть папку может только владелец.
    "
    echo "
    755	Чтение и запуск (r-x)	Чтение и запуск (r-x)	rwxr-xr-x	Стандарт для сайтов и скриптов. Владелец меняет код, а веб-сервер (Nginx/Apache) и пользователи могут его исполнять.
    "
    echo "
    744	Только чтение (r--)	Только чтение (r--)	rwxr--r--	Просмотр без запуска. Владелец может запускать скрипт, а остальные могут только посмотреть его исходный код.
    "
    echo "
    775	Полные права (rwx)	Чтение и запуск (r-x)	rwxrwxr-x	Командная разработка. Вы и коллеги из вашей группы можете полноценно кодить, остальные — только запускать продукт.
    "
    echo "
    770	Полные права (rwx)	Доступа нет (---)	rwxrwx---	Приватный проект группы. Посторонние пользователи вообще не имеют доступа к файлу или папке.
    "
    echo "
    750	Чтение и запуск (r-x)	Доступа нет (---)	rwxr-x---	Контроль группы. Коллеги могут использовать и читать файлы, чужие — полностью изолированы.
    "
    echo "
    700	Доступа нет (---)	Доступа нет (---)	rwx------	Максимальная приватность. Файл или каталог доступен исключительно вам. Идеально для личных скриптов автоматизации.
    "
    echo "############################################################################################################################################################################################"
    fi
    if [[ "$message" == "request" ]];
    then
    echo "Введите название файла ( если он находится в этой же директории ) или его путь"
    read file
    echo "Введите цифровой код прав"
    read request
    if [[ -e "$file" ]];
    then
        chmod "$request" "$file"
        echo "Права $request для файла $file успешно установлены!"
        ls -l "$file"
        else
        echo "Ошибка: Файл '$file' не найден."
    fi
    fi
    if [[ "$message" == "exit" ]];
    then
    break
    fi
    done
